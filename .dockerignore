# Dependencies — installed fresh inside the image for the right platform
node_modules
client/node_modules
server/node_modules

# Build output — regenerated by the Docker build itself
client/dist

# Local secrets — production values are set with `fly secrets set`
.env
server/.env
client/.env
client/.env.local
client/.env.development
# (.env.production is NOT ignored — Vite needs it during the build and it
# holds no secrets, just VITE_API_BASE_URL=/api)

# SQLite data — production data lives on the Fly.io volume, not in the image
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Misc
.git
.gitignore
*.md
.DS_Store
